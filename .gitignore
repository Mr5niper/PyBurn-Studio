# ===========================================================================
#  .gitignore  (PyBurn-Studio)
# ---------------------------------------------------------------------------

# --- built executables (any location) -------------------------------------
*.exe

# --- PyInstaller build byproducts ------------------------------------------
# The whole output tree is regenerated by each build and should not be
# committed. NOTE: pyburn_studio.spec is the checked-in build recipe and is
# intentionally NOT ignored.
build/
dist/

# --- local virtual environments (created by BUILD_EXE.bat) -----------------
venv/
.venv/
env/

# --- Python caches ---------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Logs and runtime state written by the app -----------------------------
*.log

# --- IDE / editor ----------------------------------------------------------
.idea/
.vscode/

# --- OS cruft --------------------------------------------------------------
.DS_Store
Thumbs.db
