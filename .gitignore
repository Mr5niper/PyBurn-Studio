# ===========================================================================
#  .gitignore  (PyBurn-Studio)
# ---------------------------------------------------------------------------

# --- built executables (any location) -------------------------------------
*.exe

# --- PyInstaller build byproducts ------------------------------------------
# The whole output tree is regenerated by each build and should not be
# committed. The build recipe now lives in BUILD_EXE.bat (command-line
# PyInstaller), so the .spec is a generated artifact and is ignored too.
build/
dist/
*.spec

# --- local virtual environments (created by BUILD_EXE.bat) -----------------
venv/
.venv/
env/

# --- Python caches ---------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Logs and runtime state written by the app -----------------------------
*.log

# --- IDE / editor ----------------------------------------------------------
.idea/
.vscode/

# --- OS cruft --------------------------------------------------------------
.DS_Store
Thumbs.db

# --- downloaded tools (ffmpeg fetched by Setup) ---
tools/
